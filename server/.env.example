# Porta em que o Geploy escuta (confira antes com `netstat -ano` se a porta
# ja esta em uso por outro sistema no servidor)
PORT=7070

# Segredo usado para assinar os JWT de sessao. Gere um valor aleatorio forte.
JWT_SECRET=troque-este-valor-por-uma-string-aleatoria-longa

# Chave mestra (32 bytes em hex = 64 caracteres) usada para criptografar
# credenciais git (tokens/PAT) salvas no banco. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GEPLOY_MASTER_KEY=

# Usados apenas pelo script scripts/seed-admin.js para criar o primeiro admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=troque-esta-senha

# Caminho do arquivo do banco SQLite
DB_PATH=../data/geploy.db
